# PayPulse AI Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database ──────────────────────────────────────────────────────────────────
# For Supabase PostgreSQL:
# Copy your connection string from Supabase Dashboard -> Settings -> Database -> Connection string (URI)
# Example: postgresql://postgres.yourprojectref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Or Direct: postgresql://postgres:[YOUR-PASSWORD]@db.yourprojectref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paypulse
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/paypulse

# ─── AI (Google Gemini) ────────────────────────────────────────────────────────
# Get your key from: https://makersuite.google.com/app/apikey
# If not provided, system falls back to deterministic investigation (fully functional)
GEMINI_API_KEY=

# ─── Razorpay (Optional - for test mode integration) ──────────────────────────
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=PayPulse AI
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# ─── Anomaly Detection Thresholds ─────────────────────────────────────────────
ANOMALY_ZSCORE_THRESHOLD=2.5
ANOMALY_PCT_DEVIATION_THRESHOLD=15.0
ANOMALY_MIN_TRANSACTIONS=20
ANOMALY_WINDOW_MINUTES=30
BASELINE_DAYS=7

# ─── Simulator ────────────────────────────────────────────────────────────────
SIM_TPS=2.0
